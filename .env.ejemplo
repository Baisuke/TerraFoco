# =============================================================================
# TerraFoco — variables de entorno
#
# Copiar este archivo como .env y completar los valores reales.
# El .env NUNCA se sube al repositorio: ya está en el .gitignore.
#
# Si una credencial se sube por accidente a un repositorio público, no basta
# con borrarla en un commit posterior: queda en el historial. Hay que cambiar
# la contraseña en el servicio.
# =============================================================================

# --- Base de datos ---
BD_PASSWORD=desarrollo_local

# --- Clave de administración de la API ---
# La piden las operaciones que escriben (alta y cambio de fuentes). Sin ella
# la API solo lee. Mínimo 24 caracteres; generarla, no inventarla:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TERRAFOCO_CLAVE_ADMIN=

# Orígenes que el navegador deja leer la API, separados por coma. "*" sirve
# en desarrollo; en un despliegue público, la URL del visor.
# TERRAFOCO_ORIGENES=https://visor.ejemplo.cl

# --- Región sobre la que opera el motor (6 = O'Higgins) ---
ID_REGION=6

# --- NASA Earthdata: https://urs.earthdata.nasa.gov ---
# Usuario y contraseña sirven para todo. El token es opcional y se prefiere en
# servidores: dura 60 días y se revoca sin tocar la contraseña de la cuenta.
# Se genera en el perfil -> Generate Token (máximo 2 activos).
EARTHDATA_USER=
EARTHDATA_PASS=
EARTHDATA_TOKEN=

# --- Copernicus Data Space: https://dataspace.copernicus.eu ---
# CDSE NO entrega una API key. La API pide un token OAuth2 que se obtiene con
# usuario y contraseña contra CDSE_TOKEN_URL, y que dura ~10 minutos.
#
# OJO: si activas la verificación en dos pasos, el flujo por contraseña exige
# además un código TOTP y las descargas automáticas dejan de funcionar solas.
CDSE_USER=
CDSE_PASS=

# Claves S3 para descargas masivas, en https://eodata-s3keysmanager.dataspace.copernicus.eu
# El secreto se muestra UNA sola vez. Necesarias recién cuando haya que bajar
# series completas de Sentinel-2; para una o dos escenas basta el token.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# --- USGS EarthExplorer: https://ers.cr.usgs.gov ---
# El acceso M2M se solicita aparte en https://ers.cr.usgs.gov/profile/access
# y puede tardar días en aprobarse. El token de aplicación reemplaza a la
# contraseña y solo se muestra 60 segundos. Se usa en el módulo 3 (Landsat).
USGS_USER=
USGS_TOKEN=

# --- Sentinel Hub: calculo de NDVI en el servidor ---
# Cliente OAuth propio, gratis. Se crea en:
#   https://shapps.dataspace.copernicus.eu/dashboard
#   -> User settings -> OAuth clients -> Create
# El secreto se muestra UNA sola vez.
SH_CLIENT_ID=
SH_CLIENT_SECRET=
