<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_TerraFoco"
                  targetNamespace="http://terrafoco.duoc.cl/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_REPO" name="Repositorios satelitales y geoespaciales"/>
    <bpmn:participant id="Participant_TF" name="TerraFoco" processRef="Process_TF"/>
    <bpmn:participant id="Participant_ORG" name="Organismos públicos — INDAP y SAG"/>
    <bpmn:messageFlow id="m1" name="Solicitud de acceso a información pública" sourceRef="t_saip" targetRef="Participant_ORG"/>
    <bpmn:messageFlow id="m2" name="Nómina de beneficiarios" sourceRef="Participant_ORG" targetRef="t_esperar"/>
    <bpmn:messageFlow id="m3" name="Escenas Sentinel-2" sourceRef="t_s2" targetRef="Participant_REPO"/>
    <bpmn:messageFlow id="m4" name="Teselas DEM" sourceRef="t_srtm" targetRef="Participant_REPO"/>
    <bpmn:messageFlow id="m5" name="Planillas de Transparencia Activa" sourceRef="t_etl" targetRef="Participant_ORG"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_TF" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_admin" name="Administrador de datos"><bpmn:flowNodeRef>ev_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef><bpmn:flowNodeRef>g_faltan</bpmn:flowNodeRef><bpmn:flowNodeRef>t_saip</bpmn:flowNodeRef><bpmn:flowNodeRef>t_esperar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cargar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reducida</bpmn:flowNodeRef><bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef><bpmn:flowNodeRef>t_disparar</bpmn:flowNodeRef><bpmn:flowNodeRef>bev_plazo</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane_motor" name="Motor de procesamiento"><bpmn:flowNodeRef>g_fork</bpmn:flowNodeRef><bpmn:flowNodeRef>t_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>t_srtm</bpmn:flowNodeRef><bpmn:flowNodeRef>t_etl</bpmn:flowNodeRef><bpmn:flowNodeRef>t_facC</bpmn:flowNodeRef><bpmn:flowNodeRef>t_facLS</bpmn:flowNodeRef><bpmn:flowNodeRef>t_facP</bpmn:flowNodeRef><bpmn:flowNodeRef>g_join</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rusle</bpmn:flowNodeRef><bpmn:flowNodeRef>t_indice</bpmn:flowNodeRef><bpmn:flowNodeRef>g_valida</bpmn:flowNodeRef><bpmn:flowNodeRef>t_persistir</bpmn:flowNodeRef><bpmn:flowNodeRef>t_desv</bpmn:flowNodeRef><bpmn:flowNodeRef>t_publicar</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane_anal" name="Analista territorial"><bpmn:flowNodeRef>t_revres</bpmn:flowNodeRef><bpmn:flowNodeRef>g_conforme</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reporte</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_fin</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_inicio" name="Inicio de ciclo trimestral"><bpmn:outgoing>f01</bpmn:outgoing><bpmn:timerEventDefinition id="td_ev_inicio"/></bpmn:startEvent>
    <bpmn:task id="t_revisar" name="Revisar catálogo&#10;de fuentes"><bpmn:incoming>f01</bpmn:incoming><bpmn:outgoing>f02</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="g_faltan" name="¿Faltan datos de ejecución del programa?"><bpmn:incoming>f02</bpmn:incoming><bpmn:outgoing>f03</bpmn:outgoing><bpmn:outgoing>f09</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="t_saip" name="Presentar solicitud&#10;de transparencia"><bpmn:incoming>f03</bpmn:incoming><bpmn:outgoing>f04</bpmn:outgoing></bpmn:task>
    <bpmn:receiveTask id="t_esperar" name="Esperar respuesta&#10;del organismo"><bpmn:incoming>f04</bpmn:incoming><bpmn:outgoing>f05</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:task id="t_cargar" name="Cargar datos&#10;recibidos"><bpmn:incoming>f05</bpmn:incoming><bpmn:outgoing>f07</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t_reducida" name="Marcar cálculo con&#10;precisión reducida"><bpmn:incoming>f06</bpmn:incoming><bpmn:outgoing>f08</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="g_merge" name=""><bpmn:incoming>f07</bpmn:incoming><bpmn:incoming>f08</bpmn:incoming><bpmn:incoming>f09</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="t_disparar" name="Disparar ciclo&#10;de procesamiento"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="g_fork" name=""><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="t_s2" name="Descargar imágenes&#10;Sentinel-2"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_srtm" name="Descargar modelo&#10;de elevación SRTM"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_etl" name="Consolidar ejecución&#10;del SIRSD-S"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_facC" name="Derivar factor C&#10;de cobertura"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_facLS" name="Derivar factor LS&#10;topográfico"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_facP" name="Derivar factor P&#10;de prácticas"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="g_join" name=""><bpmn:incoming>f18</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="t_rusle" name="Aplicar modelo&#10;RUSLE"><bpmn:incoming>f21</bpmn:incoming><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_indice" name="Calcular índice&#10;de pertinencia"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_valida" name="¿Coincide con la línea base CIREN?"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_persistir" name="Persistir indicadores&#10;en PostGIS"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="t_desv" name="Registrar desviación&#10;y ajustar parámetros"><bpmn:incoming>f25</bpmn:incoming><bpmn:incoming>f32</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="t_publicar" name="Publicar en&#10;API y visor"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_revres" name="Revisar resultados&#10;en el visor"><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_conforme" name="¿Resultados conformes?"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing><bpmn:outgoing>f32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_reporte" name="Emitir reporte&#10;trimestral"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="ev_fin" name="Ciclo publicado"><bpmn:incoming>f31</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="bev_plazo" name="20 días hábiles" attachedToRef="t_esperar" cancelActivity="true"><bpmn:outgoing>f06</bpmn:outgoing><bpmn:timerEventDefinition id="td_bev_plazo"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f01" name="" sourceRef="ev_inicio" targetRef="t_revisar"/>
    <bpmn:sequenceFlow id="f02" name="" sourceRef="t_revisar" targetRef="g_faltan"/>
    <bpmn:sequenceFlow id="f03" name="Sí" sourceRef="g_faltan" targetRef="t_saip"/>
    <bpmn:sequenceFlow id="f04" name="" sourceRef="t_saip" targetRef="t_esperar"/>
    <bpmn:sequenceFlow id="f05" name="Recibida" sourceRef="t_esperar" targetRef="t_cargar"/>
    <bpmn:sequenceFlow id="f06" name="" sourceRef="bev_plazo" targetRef="t_reducida"/>
    <bpmn:sequenceFlow id="f07" name="" sourceRef="t_cargar" targetRef="g_merge"/>
    <bpmn:sequenceFlow id="f08" name="" sourceRef="t_reducida" targetRef="g_merge"/>
    <bpmn:sequenceFlow id="f09" name="No" sourceRef="g_faltan" targetRef="g_merge"/>
    <bpmn:sequenceFlow id="f10" name="" sourceRef="g_merge" targetRef="t_disparar"/>
    <bpmn:sequenceFlow id="f11" name="" sourceRef="t_disparar" targetRef="g_fork"/>
    <bpmn:sequenceFlow id="f12" name="" sourceRef="g_fork" targetRef="t_s2"/>
    <bpmn:sequenceFlow id="f13" name="" sourceRef="g_fork" targetRef="t_srtm"/>
    <bpmn:sequenceFlow id="f14" name="" sourceRef="g_fork" targetRef="t_etl"/>
    <bpmn:sequenceFlow id="f15" name="" sourceRef="t_s2" targetRef="t_facC"/>
    <bpmn:sequenceFlow id="f16" name="" sourceRef="t_srtm" targetRef="t_facLS"/>
    <bpmn:sequenceFlow id="f17" name="" sourceRef="t_etl" targetRef="t_facP"/>
    <bpmn:sequenceFlow id="f18" name="" sourceRef="t_facC" targetRef="g_join"/>
    <bpmn:sequenceFlow id="f19" name="" sourceRef="t_facLS" targetRef="g_join"/>
    <bpmn:sequenceFlow id="f20" name="" sourceRef="t_facP" targetRef="g_join"/>
    <bpmn:sequenceFlow id="f21" name="" sourceRef="g_join" targetRef="t_rusle"/>
    <bpmn:sequenceFlow id="f22" name="" sourceRef="t_rusle" targetRef="t_indice"/>
    <bpmn:sequenceFlow id="f23" name="" sourceRef="t_indice" targetRef="g_valida"/>
    <bpmn:sequenceFlow id="f24" name="Sí" sourceRef="g_valida" targetRef="t_persistir"/>
    <bpmn:sequenceFlow id="f25" name="No" sourceRef="g_valida" targetRef="t_desv"/>
    <bpmn:sequenceFlow id="f26" name="Reprocesar" sourceRef="t_desv" targetRef="t_rusle"/>
    <bpmn:sequenceFlow id="f27" name="" sourceRef="t_persistir" targetRef="t_publicar"/>
    <bpmn:sequenceFlow id="f28" name="" sourceRef="t_publicar" targetRef="t_revres"/>
    <bpmn:sequenceFlow id="f29" name="" sourceRef="t_revres" targetRef="g_conforme"/>
    <bpmn:sequenceFlow id="f30" name="Sí" sourceRef="g_conforme" targetRef="t_reporte"/>
    <bpmn:sequenceFlow id="f31" name="" sourceRef="t_reporte" targetRef="ev_fin"/>
    <bpmn:sequenceFlow id="f32" name="No" sourceRef="g_conforme" targetRef="t_desv"/>
  </bpmn:process>
